# ---- Database (used by docker-compose) ----
POSTGRES_USER=onboardiq
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=onboardiq

# ---- App ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-64-hex-chars
# Set to true once served over HTTPS (Caddy)
COOKIE_SECURE=true

# Encrypts files in the HR document vault (AES-256-GCM). Generate with: openssl rand -hex 32
# If left empty, a key is derived from SESSION_SECRET. Set it separately for production, and back it up:
# files cannot be decrypted without it.
FILE_ENCRYPTION_KEY=

# Timezone used to display dates and to read offboarding deadlines (IANA name)
APP_TIMEZONE=America/Chicago

# Extra AD groups people may request in the Access requests module (comma separated)
EXTRA_ACCESS_GROUPS=

# ---- Public site (Caddy) ----
# localhost = self-signed cert for testing. On Azure use your DNS name, e.g. onboardiq.eastus.cloudapp.azure.com
SITE_ADDRESS=localhost

# ---- Auth mode ----
# dev = built-in test users (hr / manager / it / auditor, password "devpass"), AD actions are simulated
# ad  = real Active Directory over LDAPS
AUTH_MODE=dev

# ---- Active Directory (AUTH_MODE=ad) ----
LDAP_URL=ldaps://dc01.corp.local:636
LDAP_BASE_DN=DC=corp,DC=local
LDAP_USERS_OU=OU=OnboardIQ Users,DC=corp,DC=local
LDAP_UPN_SUFFIX=corp.local
# Limited service account (NOT Domain Admin): delegate create/reset/disable + group membership on the OU only
LDAP_SERVICE_DN=CN=svc-onboardiq,OU=Service Accounts,DC=corp,DC=local
LDAP_SERVICE_PASSWORD=change-me
# Set to false only for lab testing with a self-signed DC cert
LDAP_TLS_REJECT_UNAUTHORIZED=true

# AD group (CN) -> app role
GROUP_HR=OnboardIQ-HR
GROUP_MANAGER=OnboardIQ-Managers
GROUP_IT=OnboardIQ-IT
GROUP_AUDITOR=OnboardIQ-Auditors
